#!/usr/bin/env bash

# omavcam — use an Android phone as a virtual webcam.
#
# Every system interaction in the plugin lives here. The QML front end only
# reads this script's JSON and calls its subcommands, so the whole feature is
# testable from a terminal and a broken shell plugin can never strand a
# capture process.

set -euo pipefail

# Defined before anything else so the configuration below can reject bad input.
die() {
  printf 'omavcam: %s\n' "$*" >&2
  exit 1
}

readonly MODULE="v4l2loopback"
readonly CARD_LABEL="omavcam"
readonly MODPROBE_CONF="/etc/modprobe.d/omavcam.conf"
readonly MODULES_LOAD_CONF="/etc/modules-load.d/omavcam.conf"

# Which /dev/videoN the virtual camera claims. Overridable for the rare machine
# where 42 is already taken by another loopback consumer.
#
# This value is interpolated into /etc/modprobe.d/omavcam.conf, which is written
# as root and then parsed by modprobe with privileges, so it is checked before
# it can get that far. Anything other than a bare decimal — a space, a quote, a
# newline — would let the caller append modprobe directives of its own across
# that privilege boundary. 255 is the last minor the video device registry
# hands out; leading zeros are refused rather than silently read as octal.
VIDEO_NR="${OMAVCAM_VIDEO_NR:-42}"
if ! [[ $VIDEO_NR =~ ^(0|[1-9][0-9]*)$ ]] || ((VIDEO_NR > 255)); then
  die "OMAVCAM_VIDEO_NR must be a whole number from 0 to 255, not '$VIDEO_NR'"
fi
readonly VIDEO_NR
readonly DEVICE="/dev/video${VIDEO_NR}"

# scrcpy captures, adb finds the phone, v4l2loopback-dkms backs the node.
readonly REQUIRED_PACKAGES=(scrcpy android-tools v4l2loopback-dkms)

# max_openers above 1 is what lets the preview window read the same node the
# meeting app is reading.
readonly MAX_OPENERS=10

# Capture state lives in the runtime dir so a reboot cannot leave a stale pid
# behind claiming a capture is running.
#
# The fallback is per-user rather than a shared /tmp/omavcam. This script reads
# pids from here and signals them, so a path any user can create is a way to
# aim a kill: pre-create the directory, drop in a pid file, and wait. The reads
# are already guarded — a pid is only signalled after /proc confirms the process
# is ours — but a predictable shared path should not be the first line of
# defence, and it is exactly the shape the marketplace security baseline flags.
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp/omavcam-$(id -u)}/omavcam"
readonly STATE_DIR
readonly PID_FILE="$STATE_DIR/capture.pid"
readonly META_FILE="$STATE_DIR/capture.json"
readonly LOG_FILE="$STATE_DIR/capture.log"
readonly PREVIEW_PID_FILE="$STATE_DIR/preview.pid"
readonly PREVIEW_WATCH_PID_FILE="$STATE_DIR/preview-watch.pid"
readonly PREVIEW_INPUT_CONF="$STATE_DIR/preview-input.conf"
readonly PREVIEW_DRAG_FILE="$STATE_DIR/preview.drag"
readonly PREVIEW_HYPR_SNAP_FILE="$STATE_DIR/hypr-snap.json"
readonly PREVIEW_SIZE_FILE="$STATE_DIR/preview.size"

# STATE_DIR lives under XDG_RUNTIME_DIR, which is tmpfs: nothing in it survives
# a reboot. A remembered preview position has to, or it is not remembered at
# all, so preferences go in the user's state directory instead.
CONFIG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omavcam"
readonly CONFIG_DIR
readonly PREVIEW_ANCHOR_FILE="$CONFIG_DIR/preview.anchor"
readonly PREVIEW_SNAP_FILE="$CONFIG_DIR/preview.snap"

# The preview window is identified by title, which both mpv and scrcpy can set,
# so one set of Hyprland rules covers either source.
readonly PREVIEW_TITLE="OmavcamPreview"
# The gap a parked preview keeps from whatever it is parked against, as parts
# per thousand of the monitor's logical height. Proportional rather than fixed
# so it looks the same on a 1080p laptop and a 4K desktop: 45/1000 is the 40px
# this was hard-coded to, on the 900-logical-pixel screen it was written on.
# Logical pixels already carry the display's scale, so a HiDPI panel gets the
# same apparent gap rather than a hairline one.
readonly PREVIEW_MARGIN_PER_MILLE=45
readonly PREVIEW_MARGIN_MIN=24
readonly PREVIEW_MARGIN_MAX=96

# Where a preview can be parked: the four corners, the middle of each edge, and
# the centre. Names rather than coordinates, because the coordinates are worked
# out against whichever monitor the window is on — so a remembered anchor is
# still the right place on a second screen, at another resolution, or after the
# window has been resized.
readonly PREVIEW_ANCHORS=(
  top-left top top-right
  left center right
  bottom-left bottom bottom-right
)
readonly PREVIEW_DEFAULT_ANCHOR="bottom-right"

# Hyprland reports no event when a window is dragged: `movewindow` is a change
# of workspace, not of position. The end of a drag therefore has to be inferred
# from the window's geometry, which means polling it.
#
# Two rates, because the cost of a tick is three short-lived processes and the
# preview spends almost all of its life sitting still: a slow beat while nothing
# moves, and a fast one for as long as something is. The idle rate is what a
# short drag waits on before anything notices it at all, so it is the half of
# the delay that is felt, and it is kept low enough that a flick does not sit
# unanswered.
readonly PREVIEW_WATCH_IDLE=0.4
readonly PREVIEW_WATCH_ACTIVE=0.12

# Fast ticks a window must hold still before the drag counts as finished. Two is
# a quarter of a second — the shortest wait that is not tripped by the pauses in
# an ordinary drag. Nothing can make it zero: the compositor owns the window's
# position for as long as a drag is in progress and overwrites anything written
# underneath it, so the snap has to wait for the drag to be over.
readonly PREVIEW_WATCH_SETTLE=2

# How old the mark left by a click may be and still be taken as the start of the
# drag that is now under way. It only has to cover the gap between pressing the
# button and moving the mouse; five seconds is generous for that and short
# enough that a click, a pause, and then a Super drag is not mistaken for one
# gesture.
readonly PREVIEW_DRAG_GRACE=5

PREVIEW_SNAP="${OMAVCAM_PREVIEW_SNAP:-}"
readonly PREVIEW_SNAP

# loopback shows the node itself — exactly the frames the meeting app receives,
# and independent of the capture, so it can be toggled at will. scrcpy shows
# scrcpy's own window, which costs no second process and can control the phone,
# but is part of the capture and so toggling it restarts the stream.
PREVIEW_SOURCE="${OMAVCAM_PREVIEW_SOURCE:-loopback}"
readonly PREVIEW_SOURCE

# Reads a flag's value, allowing it to be empty but not missing.
option_value() {
  local name="$1"
  shift
  (($# >= 2)) || die "--$name needs a value"
  printf '%s' "$2"
}

usage() {
  cat <<'USAGE'
Usage: omavcam <command> [options]

Commands:
  doctor [--json]   Report whether the system can run omavcam
  setup [--yes]     Install dependencies and configure the virtual camera
  uninstall [--yes] Undo setup: remove the module config and unload it
                    (--packages also removes scrcpy, adb and v4l2loopback)
  devices [--json]  List Android devices adb can see
  cameras [--json]  List the cameras on the phone
  start [options]   Start streaming the phone camera to the virtual camera
  restart [options] Apply new settings to a running capture
  stop              Stop streaming
  status [--json]   Report whether a capture is running
  preview <action>  on, off, toggle, reopen, move <anchor>, resize <preset>,\n                    or snap on|off|toggle|status
  help              Show this message

Start options:
  -s, --serial <serial>   Which phone to use, when more than one is attached
      --facing <f>        front, back, or external (default: front)
      --camera-id <id>    Explicit camera id; overrides --facing
      --size <WxH>        Capture resolution; must be one the camera offers,
                          as listed by "omavcam cameras"
      --window            Show scrcpy's own window (used by the scrcpy preview)
      --fps <n>           Capture frame rate
      --v4l2-buffer <ms>  Buffering, to smooth a stuttering stream

Preview presets:
  small, medium, large, original, smaller, larger, reset

  original is the stream's real pixel size, uncompressed — on a phone that
  out-resolves the monitor the window is larger than the screen by design.

Preview anchors:
  top-left, top, top-right, left, center, right,
  bottom-left, bottom, bottom-right

  The anchor is remembered, so a resize or a reopen puts the preview back
  where it was last placed. With snapping on, dragging the preview near an
  anchor and letting go parks it there; dropping it anywhere else leaves it
  exactly where it was dropped.

Environment:
  OMAVCAM_VIDEO_NR        Which /dev/videoN to claim, 0-255 (default: 42)
  OMAVCAM_PREVIEW_SOURCE  loopback (default) or scrcpy
  OMAVCAM_PREVIEW_SNAP    on (default) or off — overrides the saved preference
USAGE
}

have() {
  command -v "$1" >/dev/null 2>&1
}

pkg_installed() {
  pacman -Q "$1" >/dev/null 2>&1
}

# The headers package matching the running kernel, which DKMS needs to build
# v4l2loopback. Arch records the kernel's pkgbase next to its modules, so this
# resolves correctly on linux, linux-lts, linux-zen, and friends.
kernel_headers_package() {
  local pkgbase_file pkgbase
  pkgbase_file="/usr/lib/modules/$(uname -r)/pkgbase"
  if [[ -r $pkgbase_file ]] && read -r pkgbase <"$pkgbase_file" && [[ -n $pkgbase ]]; then
    printf '%s-headers\n' "$pkgbase"
  else
    printf 'linux-headers\n'
  fi
}

module_loaded() {
  [[ -d /sys/module/$MODULE ]]
}

# Available to modprobe — true once the DKMS build has installed it, whether or
# not it is currently loaded.
module_available() {
  modinfo "$MODULE" >/dev/null 2>&1
}

# Module parameters are readable only while the module is loaded. video_nr is an
# array parameter, so it reads back as a comma-separated list.
module_param() {
  local path="/sys/module/$MODULE/parameters/$1"
  [[ -r $path ]] || return 1
  tr -d '\n' <"$path"
}

# The card label the kernel reports for our node, which is what shows up in an
# application's camera picker. Empty when the node does not exist.
device_card_label() {
  [[ -e $DEVICE ]] || return 1
  v4l2-ctl --device "$DEVICE" --info 2>/dev/null |
    sed -n 's/^[[:space:]]*Card type[[:space:]]*:[[:space:]]*//p' |
    head -1
}

conf_content_modprobe() {
  cat <<EOF
# Managed by omavcam — https://github.com/Sphiment/omavcam
#
# exclusive_caps=1 makes the node advertise capture capability only while
# something is writing to it, so "omavcam" appears in camera pickers exactly
# when it is streaming instead of haunting every dropdown.
options $MODULE video_nr=$VIDEO_NR card_label="$CARD_LABEL" exclusive_caps=1 max_openers=$MAX_OPENERS
EOF
}

conf_content_modules_load() {
  cat <<EOF
# Managed by omavcam — https://github.com/Sphiment/omavcam
$MODULE
EOF
}

conf_matches() {
  local path="$1" want="$2"
  [[ -r $path ]] && [[ "$(cat "$path")" == "$want" ]]
}

# ---------------------------------------------------------------- doctor ----

# Collects the whole picture once, so the human and JSON renderings can never
# disagree about what was observed.
declare -a MISSING_PACKAGES=()
declare -a ISSUES=()
STATE_MODULE_AVAILABLE=false
STATE_MODULE_LOADED=false
STATE_DEVICE_PRESENT=false
STATE_DEVICE_LABEL=""
STATE_LABEL_MATCHES=false
STATE_PERSISTED=false
STATE_HEADERS_PACKAGE=""
STATE_HEADERS_INSTALLED=false

# code|severity|message — severity is "blocked" when omavcam cannot capture at
# all, "warn" when it works but something will not survive a reboot.
add_issue() {
  ISSUES+=("$1|$2|$3")
}

inspect() {
  local pkg
  for pkg in "${REQUIRED_PACKAGES[@]}"; do
    pkg_installed "$pkg" || MISSING_PACKAGES+=("$pkg")
  done

  STATE_HEADERS_PACKAGE="$(kernel_headers_package)"
  pkg_installed "$STATE_HEADERS_PACKAGE" && STATE_HEADERS_INSTALLED=true

  module_available && STATE_MODULE_AVAILABLE=true
  module_loaded && STATE_MODULE_LOADED=true

  if [[ -e $DEVICE ]]; then
    STATE_DEVICE_PRESENT=true
    STATE_DEVICE_LABEL="$(device_card_label || true)"
    [[ $STATE_DEVICE_LABEL == "$CARD_LABEL" ]] && STATE_LABEL_MATCHES=true
  fi

  if conf_matches "$MODPROBE_CONF" "$(conf_content_modprobe)" &&
    conf_matches "$MODULES_LOAD_CONF" "$(conf_content_modules_load)"; then
    STATE_PERSISTED=true
  fi

  if ((${#MISSING_PACKAGES[@]} > 0)); then
    add_issue missing-packages blocked \
      "Missing packages: ${MISSING_PACKAGES[*]}"
  fi

  if [[ $STATE_HEADERS_INSTALLED == false ]]; then
    add_issue missing-headers blocked \
      "$STATE_HEADERS_PACKAGE is not installed, so DKMS cannot build $MODULE for the running kernel"
  fi

  if [[ ${#MISSING_PACKAGES[@]} -eq 0 && $STATE_MODULE_AVAILABLE == false ]]; then
    add_issue module-unavailable blocked \
      "$MODULE is installed but not built for the running kernel — check 'dkms status'"
  fi

  if [[ $STATE_MODULE_AVAILABLE == true && $STATE_MODULE_LOADED == false ]]; then
    add_issue module-not-loaded blocked "$MODULE is not loaded"
  fi

  # Loaded, but the node we want is not ours. Another consumer (OBS virtual
  # camera, v4l2-relayd) got there first with different parameters. Never
  # rmmod out from under them; say so and let the user pick a different node.
  if [[ $STATE_MODULE_LOADED == true && $STATE_DEVICE_PRESENT == false ]]; then
    add_issue device-missing blocked \
      "$MODULE is loaded but $DEVICE does not exist — it was loaded without omavcam's parameters"
  elif [[ $STATE_DEVICE_PRESENT == true && $STATE_LABEL_MATCHES == false ]]; then
    add_issue device-conflict blocked \
      "$DEVICE belongs to \"${STATE_DEVICE_LABEL:-unknown}\", not omavcam — set OMAVCAM_VIDEO_NR to a free node"
  fi

  if [[ $STATE_PERSISTED == false ]]; then
    add_issue not-persisted warn \
      "The virtual camera is not configured to come back after a reboot"
  fi
}

blocked_count() {
  local issue count=0
  for issue in ${ISSUES[@]+"${ISSUES[@]}"}; do
    if [[ ${issue#*|} == blocked\|* ]]; then
      count=$((count + 1))
    fi
  done
  printf '%s\n' "$count"
}

doctor_json() {
  local issues_json packages_json missing_json
  issues_json=$(
    for issue in ${ISSUES[@]+"${ISSUES[@]}"}; do
      IFS='|' read -r code severity message <<<"$issue"
      jq -n --arg c "$code" --arg s "$severity" --arg m "$message" \
        '{code: $c, severity: $s, message: $m}'
    done | jq -s '.'
  )

  packages_json=$(
    for pkg in "${REQUIRED_PACKAGES[@]}"; do
      jq -n --arg n "$pkg" --argjson i "$(pkg_installed "$pkg" && echo true || echo false)" \
        '{name: $n, installed: $i}'
    done | jq -s '.'
  )

  missing_json=$(printf '%s\n' ${MISSING_PACKAGES[@]+"${MISSING_PACKAGES[@]}"} |
    jq -R 'select(length > 0)' | jq -s '.')

  jq -n \
    --argjson ok "$([[ $(blocked_count) -eq 0 ]] && echo true || echo false)" \
    --argjson packages "$packages_json" \
    --argjson missingPackages "$missing_json" \
    --arg headersPackage "$STATE_HEADERS_PACKAGE" \
    --argjson headersInstalled "$STATE_HEADERS_INSTALLED" \
    --argjson moduleAvailable "$STATE_MODULE_AVAILABLE" \
    --argjson moduleLoaded "$STATE_MODULE_LOADED" \
    --arg device "$DEVICE" \
    --argjson devicePresent "$STATE_DEVICE_PRESENT" \
    --arg deviceLabel "$STATE_DEVICE_LABEL" \
    --argjson persisted "$STATE_PERSISTED" \
    --argjson issues "$issues_json" \
    '{
      ok: $ok,
      packages: $packages,
      missingPackages: $missingPackages,
      kernel: {headersPackage: $headersPackage, headersInstalled: $headersInstalled},
      module: {available: $moduleAvailable, loaded: $moduleLoaded},
      device: {path: $device, present: $devicePresent, label: $deviceLabel},
      persisted: $persisted,
      issues: $issues
    }'
}

doctor_human() {
  local mark
  printf 'omavcam doctor\n\n'

  for pkg in "${REQUIRED_PACKAGES[@]}"; do
    pkg_installed "$pkg" && mark='+' || mark='-'
    printf '  [%s] %s\n' "$mark" "$pkg"
  done
  [[ $STATE_HEADERS_INSTALLED == true ]] && mark='+' || mark='-'
  printf '  [%s] %s\n' "$mark" "$STATE_HEADERS_PACKAGE"

  printf '\n'
  [[ $STATE_MODULE_LOADED == true ]] && mark='+' || mark='-'
  printf '  [%s] %s module loaded\n' "$mark" "$MODULE"
  [[ $STATE_LABEL_MATCHES == true ]] && mark='+' || mark='-'
  printf '  [%s] %s present as "%s"\n' "$mark" "$DEVICE" "$CARD_LABEL"
  [[ $STATE_PERSISTED == true ]] && mark='+' || mark='-'
  printf '  [%s] survives a reboot\n' "$mark"

  if ((${#ISSUES[@]} == 0)); then
    printf '\nReady to capture.\n'
    return
  fi

  printf '\n'
  for issue in "${ISSUES[@]}"; do
    IFS='|' read -r _ severity message <<<"$issue"
    printf '  %-8s %s\n' "$severity" "$message"
  done

  if [[ $(blocked_count) -gt 0 ]]; then
    printf '\nRun "omavcam setup" to fix this.\n'
  fi
}

cmd_doctor() {
  local as_json=false
  while (($# > 0)); do
    case "$1" in
    --json) as_json=true ;;
    *) die "unknown option for doctor: $1" ;;
    esac
    shift
  done

  have jq || die "jq is required"
  inspect

  if [[ $as_json == true ]]; then
    doctor_json
  else
    doctor_human
  fi

  # Exit status reflects readiness, so callers can branch on it without parsing.
  [[ $(blocked_count) -eq 0 ]]
}

# ----------------------------------------------------------------- setup ----

# Omarchy's installer surfaces the pacman run and owns the sudo prompt. Fall
# back to pacman directly so the script still works outside Omarchy.
install_packages() {
  local packages=("$@")
  ((${#packages[@]} > 0)) || return 0

  printf 'Installing: %s\n' "${packages[*]}"
  if have omarchy-pkg-add; then
    omarchy-pkg-add "${packages[@]}"
  else
    sudo pacman -S --needed "${packages[@]}"
  fi
}

write_conf() {
  local path="$1" content="$2"
  if conf_matches "$path" "$content"; then
    printf 'Already current: %s\n' "$path"
    return 0
  fi
  printf 'Writing %s\n' "$path"
  printf '%s\n' "$content" | sudo tee "$path" >/dev/null
}

cmd_setup() {
  local assume_yes=false
  while (($# > 0)); do
    case "$1" in
    --yes | -y) assume_yes=true ;;
    *) die "unknown option for setup: $1" ;;
    esac
    shift
  done

  have jq || die "jq is required"
  inspect

  # Headers first: installing v4l2loopback-dkms without them leaves a package
  # installed and a module that was never built, which is a confusing state to
  # land in and a confusing one to explain.
  local to_install=()
  [[ $STATE_HEADERS_INSTALLED == false ]] && to_install+=("$STATE_HEADERS_PACKAGE")
  to_install+=(${MISSING_PACKAGES[@]+"${MISSING_PACKAGES[@]}"})

  if ((${#to_install[@]} > 0)); then
    if [[ $assume_yes == false ]]; then
      printf 'omavcam will install: %s\n' "${to_install[*]}"
      read -r -p 'Continue? [Y/n] ' reply
      [[ -z $reply || $reply =~ ^[Yy] ]] || die "cancelled"
    fi
    install_packages "${to_install[@]}"
  else
    printf 'All dependencies present.\n'
  fi

  write_conf "$MODPROBE_CONF" "$(conf_content_modprobe)"
  write_conf "$MODULES_LOAD_CONF" "$(conf_content_modules_load)"

  load_module

  printf '\n'
  ISSUES=()
  MISSING_PACKAGES=()
  STATE_PERSISTED=false
  inspect
  doctor_human
  [[ $(blocked_count) -eq 0 ]]
}

# Applies the freshly written parameters. If the module is already loaded with
# someone else's parameters, refuse to reload it — another application may be
# mid-capture on a node we do not own.
load_module() {
  if ! module_available; then
    die "$MODULE is still not available to modprobe — check 'dkms status'"
  fi

  if ! module_loaded; then
    printf 'Loading %s\n' "$MODULE"
    sudo modprobe "$MODULE"
    return
  fi

  if [[ -e $DEVICE ]] && [[ "$(device_card_label || true)" == "$CARD_LABEL" ]]; then
    printf '%s already loaded with omavcam'\''s parameters.\n' "$MODULE"
    return
  fi

  printf '%s is already loaded with different parameters.\n' "$MODULE" >&2
  printf 'Another application may be using it, so omavcam will not reload it.\n' >&2
  printf 'Reboot to pick up the new configuration, or if nothing is using it:\n' >&2
  printf '  sudo modprobe -r %s && sudo modprobe %s\n' "$MODULE" "$MODULE" >&2
  return 1
}

# --------------------------------------------------------------- capture ----

# A symlink redirects every write; a directory owned by someone else means
# someone else chooses what we read back out. Refuse both rather than carry on
# into a state store we do not control.
assert_private_dir() {
  local path="$1"
  [[ -L $path ]] && die "state directory is a symlink, refusing to use it: $path"
  [[ -d $path ]] || die "could not create state directory: $path"
  [[ -O $path ]] || die "state directory is not owned by you: $path"
  chmod 700 "$path" 2>/dev/null || true
}

ensure_state_dir() {
  local parent
  parent=$(dirname "$STATE_DIR")

  # Created a level at a time, not with `mkdir -p -m`: with -p the mode applies
  # only to the deepest directory, so the parent — the /tmp fallback, the very
  # path being defended — would be left at whatever the umask allows.
  if [[ ! -e $parent ]]; then
    mkdir -m 700 "$parent" 2>/dev/null || true
    assert_private_dir "$parent"
  fi

  [[ -d $STATE_DIR ]] || mkdir -m 700 "$STATE_DIR" 2>/dev/null || true
  assert_private_dir "$STATE_DIR"
}

# The persistent half of the state, under $HOME rather than the runtime dir.
# Reports failure instead of dying: a preference that cannot be saved is worth
# losing, never worth refusing the action the user asked for.
ensure_config_dir() {
  [[ -L $CONFIG_DIR ]] && return 1

  if [[ ! -d $CONFIG_DIR ]]; then
    # The XDG parents are made with whatever mode the user's umask gives them —
    # they are shared directories and not ours to lock down — and our own level
    # is then made explicitly at 700. `mkdir -p -m` would not do this: with -p
    # the mode reaches only the deepest directory.
    mkdir -p "${CONFIG_DIR%/*}" 2>/dev/null || return 1
    mkdir -m 700 "$CONFIG_DIR" 2>/dev/null || return 1
  fi

  [[ -O $CONFIG_DIR ]] || return 1
  return 0
}

# A pid file alone is not proof: pids get recycled, and a crashed scrcpy leaves
# the file behind. Confirm the process is alive and is actually our capture by
# looking for our own sink in its command line.
capture_pid() {
  local pid
  [[ -r $PID_FILE ]] || return 1
  read -r pid <"$PID_FILE" || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ -r /proc/$pid/cmdline ]] || return 1
  tr '\0' ' ' </proc/"$pid"/cmdline | grep -q -- "--v4l2-sink=$DEVICE" || return 1
  printf '%s\n' "$pid"
}

capture_running() {
  capture_pid >/dev/null 2>&1
}

clear_state() {
  rm -f "$PID_FILE" "$META_FILE"
}

# With exclusive_caps=1 the node only advertises Video Capture while something
# is writing to it, so this is a direct answer to "is a real stream flowing",
# not merely "is a process alive". Same check omarchy-capture-webcam-list uses.
device_streaming() {
  [[ -e $DEVICE ]] || return 1
  v4l2-ctl --device "$DEVICE" --info 2>/dev/null | awk '
    /^[[:space:]]*Device Caps[[:space:]]*:/ { inspect = 1; next }
    inspect && /^[[:space:]]*Video Capture/ { found = 1 }
    END { exit !found }
  '
}

# --------------------------------------------------------------- devices ----

# `adb devices -l` prints a header line, then one device per line:
#   ABC123   device product:panther model:Pixel_7 device:panther transport_id:2
# States other than "device" matter to the panel: "unauthorized" means the
# phone is waiting for the user to accept the debugging prompt.
adb_devices_json() {
  have adb || {
    printf '[]\n'
    return 0
  }

  adb devices -l 2>/dev/null | tail -n +2 | awk '
    NF >= 2 {
      serial = $1
      state = $2
      model = ""
      for (i = 3; i <= NF; i++)
        if ($i ~ /^model:/) { model = substr($i, 7); gsub(/_/, " ", model) }
      printf "%s\t%s\t%s\n", serial, state, model
    }
  ' | jq -R -s '
    split("\n")
    | map(select(length > 0) | split("\t"))
    | map({serial: .[0], state: .[1], model: (.[2] // ""), ready: (.[1] == "device")})
  '
}

cmd_devices() {
  local as_json=false
  while (($# > 0)); do
    case "$1" in
    --json) as_json=true ;;
    *) die "unknown option for devices: $1" ;;
    esac
    shift
  done

  have jq || die "jq is required"
  have adb || die "adb is not installed — run 'omavcam setup'"

  local devices
  devices=$(adb_devices_json)

  if [[ $as_json == true ]]; then
    printf '%s\n' "$devices"
    return 0
  fi

  if [[ $(jq 'length' <<<"$devices") -eq 0 ]]; then
    printf 'No devices. Plug the phone in and enable USB debugging.\n'
    return 1
  fi

  jq -r '.[] | "  \(.serial)\t\(.state)\t\(.model)"' <<<"$devices"
}

# Resolves which phone to talk to. With exactly one ready device the serial is
# implied; with several, the caller has to say which, since silently picking one
# would send the stream from whichever phone happened to enumerate first.
resolve_serial() {
  local requested="${1:-}" devices count
  devices=$(adb_devices_json)

  if [[ -n $requested ]]; then
    jq -e --arg s "$requested" 'any(.[]; .serial == $s and .ready)' <<<"$devices" >/dev/null ||
      die "device $requested is not connected and ready"
    printf '%s\n' "$requested"
    return 0
  fi

  count=$(jq '[.[] | select(.ready)] | length' <<<"$devices")
  case "$count" in
  0)
    if [[ $(jq 'any(.[]; .state == "unauthorized")' <<<"$devices") == true ]]; then
      die "phone is unauthorized — accept the USB debugging prompt on its screen"
    fi
    die "no phone connected — plug it in and enable USB debugging"
    ;;
  1) jq -r '[.[] | select(.ready)][0].serial' <<<"$devices" ;;
  *) die "$count phones connected — pass --serial to choose one" ;;
  esac
}

# --------------------------------------------------------------- cameras ----

# scrcpy's flag set moves between releases, so ask the binary what it accepts
# rather than assuming. Keeps a new scrcpy from breaking capture over a flag
# that was renamed.
scrcpy_supports() {
  local help
  # Captured, not piped. `scrcpy --help | grep -q` closes the pipe the moment
  # grep matches, scrcpy dies of SIGPIPE, and pipefail reports that as failure —
  # so every flag appearing early in the help text was silently judged
  # unsupported.
  help=$(scrcpy --help 2>&1 || true)
  # Anchored to the start of the option, so --no-window is not satisfied by
  # --no-window-aspect-ratio-lock.
  grep -qE "^[[:space:]]*$1([=,[:space:]]|\$)" <<<"$help"
}

cmd_cameras() {
  local as_json=false serial=""
  while (($# > 0)); do
    case "$1" in
    --json) as_json=true ;;
    -s | --serial)
      serial="${2:-}"
      shift
      ;;
    *) die "unknown option for cameras: $1" ;;
    esac
    shift
  done

  have jq || die "jq is required"
  have scrcpy || die "scrcpy is not installed — run 'omavcam setup'"

  serial=$(resolve_serial "$serial")

  local raw
  # --list-camera-sizes is a superset of --list-cameras: same header line per
  # camera, plus the resolutions it accepts. The panel needs those, because
  # scrcpy rejects any --camera-size the camera does not offer.
  raw=$(scrcpy -s "$serial" --list-camera-sizes 2>&1 || true)

  if [[ $as_json == false ]]; then
    printf '%s\n' "$raw"
    return 0
  fi

  # Output is a header line per camera:
  #     --camera-id=0    (back, 4080x3060, fps={15, 30}, zoom-range=[1, 8])
  # followed by its sizes, one "- WxH" per line, and then an optional
  # high-speed section whose sizes only apply with --camera-high-speed and so
  # must not be offered as ordinary choices.
  printf '%s\n' "$raw" | awk '
    function flush() {
      if (id != "") printf "%s\t%s\t%s\t%s\n", id, facing, desc, sizes
      id = ""; facing = ""; desc = ""; sizes = ""; highspeed = 0
    }
    /--camera-id=/ {
      flush()
      line = $0; sub(/.*--camera-id=/, "", line); id = line; sub(/[ \t].*/, "", id)
      desc = $0; sub(/^[^(]*\(/, "", desc); sub(/\)[ \t]*$/, "", desc)
      facing = desc; sub(/,.*/, "", facing); gsub(/[ \t]/, "", facing)
      next
    }
    /High speed capture/ { highspeed = 1; next }
    !highspeed && /^[ \t]*-[ \t]*[0-9]+x[0-9]+[ \t]*$/ {
      s = $0; gsub(/[ \t]/, "", s); sub(/^-/, "", s)
      sizes = (sizes == "" ? s : sizes "," s)
      next
    }
    END { flush() }
  ' | jq -R -s '
      split("\n")
      | map(select(length > 0) | split("\t"))
      | map({
          id: .[0],
          facing: (.[1] | ascii_downcase),
          description: .[2],
          sizes: (if (.[3] // "") == "" then [] else (.[3] | split(",")) end)
        })
    '
}

# ----------------------------------------------------------------- start ----

cmd_start() {
  local serial="" facing="front" camera_id="" size="" fps="" v4l2_buffer="" show_window=false
  while (($# > 0)); do
    case "$1" in
    --window) show_window=true ;;
    # Empty is accepted and means "unset", matching restart. Rejecting it here
    # made start refuse arguments restart was happy to take.
    -s | --serial) serial=$(option_value serial "$@") && shift ;;
    --facing) facing=$(option_value facing "$@") && shift ;;
    --camera-id) camera_id=$(option_value camera-id "$@") && shift ;;
    --size) size=$(option_value size "$@") && shift ;;
    --fps) fps=$(option_value fps "$@") && shift ;;
    --v4l2-buffer) v4l2_buffer=$(option_value v4l2-buffer "$@") && shift ;;
    *) die "unknown option for start: $1" ;;
    esac
    shift
  done

  case "$facing" in
  front | back | external) ;;
  *) die "--facing must be front, back, or external" ;;
  esac

  have jq || die "jq is required"
  have scrcpy || die "scrcpy is not installed — run 'omavcam setup'"

  inspect
  if [[ $(blocked_count) -gt 0 ]]; then
    doctor_human >&2
    die "system is not ready to capture"
  fi

  if capture_running; then
    die "a capture is already running — run 'omavcam stop' first"
  fi

  serial=$(resolve_serial "$serial")
  ensure_state_dir
  clear_state

  local args=(
    -s "$serial"
    --video-source=camera
    "--v4l2-sink=$DEVICE"
    --no-audio
  )

  # Explicit id wins: --camera-facing and --camera-id are mutually exclusive in
  # scrcpy, and passing both is an error rather than a preference.
  if [[ -n $camera_id ]]; then
    args+=("--camera-id=$camera_id")
  else
    args+=("--camera-facing=$facing")
  fi

  [[ -n $size ]] && args+=("--camera-size=$size")
  [[ -n $fps ]] && args+=("--camera-fps=$fps")
  [[ -n $v4l2_buffer ]] && args+=("--v4l2-buffer=$v4l2_buffer")

  if [[ $show_window == true ]]; then
    # scrcpy cannot set a Wayland app id, so the window is labelled with a title
    # the Hyprland preview rules can match on.
    args+=("--window-title=$PREVIEW_TITLE")
  else
    # Headless by default. --no-window is the clean suppression where scrcpy has
    # it; --no-video-playback is the documented v4l2 companion and covers the
    # releases that lack it.
    if scrcpy_supports --no-window; then
      args+=(--no-window)
    else
      args+=(--no-video-playback)
    fi
  fi

  printf 'Starting capture from %s on %s\n' "$serial" "$DEVICE"

  setsid scrcpy "${args[@]}" >"$LOG_FILE" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" >"$PID_FILE"

  jq -n \
    --arg serial "$serial" \
    --arg mode camera \
    --arg device "$DEVICE" \
    --arg facing "$([[ -n $camera_id ]] && printf '' || printf '%s' "$facing")" \
    --arg cameraId "$camera_id" \
    --arg size "$size" \
    --arg fps "$fps" \
    --argjson window "$show_window" \
    --argjson startedAt "$(date +%s)" \
    '{serial: $serial, mode: $mode, device: $device, facing: $facing,
      cameraId: $cameraId, size: $size, fps: $fps, window: $window,
      startedAt: $startedAt}' \
    >"$META_FILE"

  # scrcpy has to push and start its server on the phone before a frame ever
  # reaches the sink, so a plain "did the process survive" check would report
  # success long before the camera is usable. Wait for the node to actually
  # advertise capture instead.
  local waited=0
  while ((waited < 100)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      printf 'scrcpy exited before the stream started:\n\n' >&2
      tail -n 20 "$LOG_FILE" >&2
      clear_state
      return 1
    fi
    if device_streaming; then
      printf 'Streaming to %s as "%s".\n' "$DEVICE" "$CARD_LABEL"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done

  printf 'scrcpy is running but %s is not advertising capture yet.\n' "$DEVICE" >&2
  printf 'Recent output:\n\n' >&2
  tail -n 20 "$LOG_FILE" >&2
  return 1
}

# ------------------------------------------------------------------ stop ----

cmd_stop() {
  (($# == 0)) || die "stop takes no options"

  # A reader left attached strands an mpv showing a frozen last frame, and pins
  # the node's format for whatever starts next. Neither depends on which source
  # is configured, so neither does this.
  loopback_preview_stop
  hypr_snap_restore

  local pid
  if ! pid=$(capture_pid); then
    clear_state
    printf 'No capture running.\n'
    return 0
  fi

  printf 'Stopping capture (pid %s)\n' "$pid"
  kill "$pid" 2>/dev/null || true

  # scrcpy needs a moment to tear its server down on the phone; killing it
  # outright can leave the process on the device behind.
  local waited=0
  while ((waited < 50)) && kill -0 "$pid" 2>/dev/null; do
    sleep 0.1
    waited=$((waited + 1))
  done

  if kill -0 "$pid" 2>/dev/null; then
    printf 'scrcpy did not exit; killing it.\n' >&2
    kill -9 "$pid" 2>/dev/null || true
  fi

  clear_state
}

# ---------------------------------------------------------------- status ----

# What "original" would produce here, so the panel can warn before applying it
# rather than after the window is already off the screen. Null when there is no
# stream to measure.
preview_original_json() {
  local nw nh mw mh
  if ! read -r nw nh < <(preview_native_size); then
    printf 'null\n'
    return 0
  fi
  if ! read -r mw mh < <(preview_target_monitor); then
    mw=0
    mh=0
  fi

  local fits=false
  if ((mw > 0 && mh > 0 && nw <= mw && nh <= mh)); then
    fits=true
  fi

  jq -n --argjson nw "$nw" --argjson nh "$nh" \
    --argjson mw "$mw" --argjson mh "$mh" --argjson fits "$fits" \
    '{width: $nw, height: $nh, screenWidth: $mw, screenHeight: $mh, fitsScreen: $fits}'
}

cmd_status() {
  local as_json=false
  while (($# > 0)); do
    case "$1" in
    --json) as_json=true ;;
    *) die "unknown option for status: $1" ;;
    esac
    shift
  done

  have jq || die "jq is required"

  local pid running=false streaming=false meta='{}'
  if pid=$(capture_pid); then
    running=true
    [[ -r $META_FILE ]] && meta=$(cat "$META_FILE")
  else
    pid=""
    # A pid file with no live process behind it is stale; drop it so the next
    # start is not refused by a capture that is not there.
    clear_state
  fi
  device_streaming && streaming=true

  if [[ $as_json == true ]]; then
    local preview_open=false
    if preview_running; then
      preview_open=true
      # The panel polls this every few seconds, which makes it the one heartbeat
      # the preview already has. If the window is open and snapping is on but
      # nothing is watching for drags — the watcher was killed, or the preview
      # came back by a route that did not start one — this is where it is
      # noticed and put right, rather than the next time someone reopens the
      # preview by hand.
      preview_watch_start
    fi
    jq -n \
      --argjson running "$running" \
      --argjson streaming "$streaming" \
      --arg pid "$pid" \
      --argjson meta "$meta" \
      --argjson previewOpen "$preview_open" \
      --arg previewSize "$(preview_size_name)" \
      --arg previewAnchor "$(preview_anchor_name)" \
      --arg previewSnap "$(preview_snap_word)" \
      --arg previewSource "$PREVIEW_SOURCE" \
      --argjson original "$(preview_original_json)" \
      '{running: $running, streaming: $streaming, pid: $pid, capture: $meta,
        preview: {open: $previewOpen, size: $previewSize, anchor: $previewAnchor,
                  snap: ($previewSnap == "on"), source: $previewSource,
                  original: $original}}
       | .uptimeSec = (if $meta.startedAt then (now | floor) - $meta.startedAt else null end)'
    return 0
  fi

  if [[ $running == false ]]; then
    printf 'Not capturing.\n'
    return 1
  fi

  printf 'Capturing from %s\n' "$(jq -r '.serial // "?"' <<<"$meta")"
  printf '  device   %s\n' "$(jq -r '.device // "?"' <<<"$meta")"
  printf '  camera   %s\n' "$(jq -r 'if .cameraId != "" then "id " + .cameraId else .facing end' <<<"$meta")"
  printf '  pid      %s\n' "$pid"
  printf '  live     %s\n' "$streaming"
  preview_running && printf '  preview  %s at %s, snapping %s (%s)\n' \
    "$(preview_size_name)" "$(preview_anchor_name)" \
    "$(preview_snap_word)" "$PREVIEW_SOURCE"
}

# --------------------------------------------------------------- preview ----

preview_app_id() {
  printf '%s-%s\n' "$PREVIEW_TITLE" "${1:-medium}"
}

preview_size_name() {
  local size=medium
  [[ -r $PREVIEW_SIZE_FILE ]] && read -r size <"$PREVIEW_SIZE_FILE" 2>/dev/null
  case "$size" in
  small | medium | large | original) printf '%s\n' "$size" ;;
  *) printf 'medium\n' ;;
  esac
}

# Hyprland 0.56 parses its config with Lua and refuses `hyprctl keyword`, so
# rules go in through eval. The legacy keyword path stays as a fallback for
# older Hyprland, and both are best-effort: a missing preview rule costs a
# tidily placed window, never the capture.
hypr_rule() {
  hyprctl eval "$1" >/dev/null 2>&1 ||
    hyprctl keyword "$2" "$3" >/dev/null 2>&1 ||
    true
}

hypr_dispatch() {
  local lua="$1"
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null 2>&1 || true
}

# Applied at runtime rather than written into the user's Hyprland config: a
# plugin has no business editing files it does not own, and these only need to
# outlive the session.
apply_preview_rules() {
  command -v hyprctl >/dev/null 2>&1 || return 0

  # Every preset needs its own rule: the app id carries the preset name and is
  # fixed when mpv launches, so a preset with no matching rule gets no rule at
  # all and the preview is tiled into the layout instead of floating.
  local size
  for size in small medium large original; do
    hypr_rule \
      "o.window(\"^($(preview_app_id "$size"))\$\", { float = true, pin = true, no_initial_focus = true, no_dim = true, border_size = 0, opacity = \"1 1\", tag = \"-default-opacity\" })" \
      windowrule "float, class:^($(preview_app_id "$size"))\$"
  done

  # scrcpy has no way to set a Wayland app id, so its window is matched on the
  # title we gave it instead.
  hypr_rule \
    "o.window({ class = \"^(scrcpy)\$\", title = \"^($PREVIEW_TITLE)\$\" }, { float = true, pin = true, no_initial_focus = true, no_dim = true, opacity = \"1 1\", tag = \"-default-opacity\" })" \
    windowrule "float, title:^($PREVIEW_TITLE)\$"
}

preview_client() {
  command -v hyprctl >/dev/null 2>&1 || return 1
  hyprctl clients -j 2>/dev/null |
    jq -cer --arg t "$PREVIEW_TITLE" 'first(.[] | select(.title == $t)) // empty' 2>/dev/null
}
# Which source the preview that is open right now came from, as opposed to the
# one the settings would open next. The two differ at exactly one moment — while
# the source is being switched — and that is the moment a stop that trusted the
# setting would reach for the wrong process and take the capture down with it.
preview_running_source() {
  local client class
  client=$(preview_client) || return 1
  class=$(jq -r '.class // empty' <<<"$client")
  if [[ $class == scrcpy ]]; then
    printf 'scrcpy\n'
  else
    printf 'loopback\n'
  fi
}

preview_pid() {
  local pid
  [[ -r $PREVIEW_PID_FILE ]] || return 1
  read -r pid <"$PREVIEW_PID_FILE" || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ -r /proc/$pid/cmdline ]] || return 1
  tr '\0' ' ' </proc/"$pid"/cmdline | grep -q -- "$PREVIEW_TITLE" || return 1
  printf '%s\n' "$pid"
}

# The compositor knows which process owns the preview window, which is exact
# and survives a lost pid file — the case that used to strand a borderless
# window with no way to close it.
preview_client_pid() {
  local client
  client=$(preview_client) || return 1
  local pid
  pid=$(jq -r '.pid // empty' <<<"$client")
  [[ $pid =~ ^[0-9]+$ ]] && ((pid > 0)) || return 1
  printf '%s\n' "$pid"
}

# Last resort when there is no compositor to ask: walk /proc ourselves rather
# than shelling out to `pkill -f`. A pattern broad enough to find the preview is
# also broad enough to match the shell that is searching for it — pkill will
# happily kill its own caller, which is how a stop once took the script down
# with it instead of the window.
preview_scan_pid() {
  local dir pid cmdline
  for dir in /proc/[0-9]*; do
    pid=${dir#/proc/}
    ((pid != $$)) || continue
    [[ -r $dir/cmdline ]] || continue
    cmdline=$(tr '\0' ' ' <"$dir/cmdline" 2>/dev/null) || continue
    # Match the launch flag, not the bare title: any shell mentioning the title
    # (this script included) would otherwise look like the preview.
    [[ $cmdline == *"--wayland-app-id=$PREVIEW_TITLE"* ]] || continue
    [[ $cmdline == mpv* || $cmdline == */mpv\ * ]] || continue
    printf '%s\n' "$pid"
    return 0
  done
  return 1
}

# True for either source: an mpv we launched, or scrcpy's own window on screen.
preview_running() {
  preview_pid >/dev/null 2>&1 || preview_client >/dev/null 2>&1
}

# An mpv preview specifically, regardless of which source is configured.
#
# This matters for cleanup rather than display: any reader attached to the node
# pins its format, so v4l2loopback cannot shrink it for the next capture. Leave
# one open across a restart and scrcpy streams the new camera into the old
# camera's geometry — the capture looks healthy, the picture is wrong. So a
# reader is always torn down before a restart, whatever previewSource says;
# the setting decides what gets opened, never what gets cleaned up.
loopback_preview_pid() {
  preview_pid 2>/dev/null || preview_scan_pid 2>/dev/null
}

loopback_preview_stop() {
  local pid
  pid=$(loopback_preview_pid || true)
  [[ -n $pid ]] || return 0

  kill "$pid" 2>/dev/null || true
  local waited=0
  while ((waited < 20)) && kill -0 "$pid" 2>/dev/null; do
    sleep 0.1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PREVIEW_PID_FILE"
}

# The stream's real pixel dimensions, or failure if the node cannot be read.
preview_native_size() {
  local width height
  read -r width height < <(
    v4l2-ctl --device "$DEVICE" --get-fmt-video 2>/dev/null |
      sed -n 's/^[[:space:]]*Width\/Height[[:space:]]*:[[:space:]]*\([0-9]*\)\/\([0-9]*\).*/\1 \2/p' |
      head -1
  )
  [[ ${width:-0} =~ ^[0-9]+$ ]] && [[ ${height:-0} =~ ^[0-9]+$ ]] || return 1
  ((width > 0 && height > 0)) || return 1
  printf '%s %s\n' "$width" "$height"
}

# The stream's own aspect ratio, so the preview is never letterboxed or
# stretched. Falls back to 16:9 when the node cannot be read.
preview_aspect() {
  preview_native_size || printf '16 9\n'
}

# Logical size of the monitor the preview would land on: the one it already
# occupies, or the focused one when it is closed. Logical rather than physical,
# because window geometry is in logical units — on a scaled display the two
# differ, and comparing a stream's pixels against physical ones would call a
# window "fitting" while it runs off the screen.
preview_target_monitor() {
  command -v hyprctl >/dev/null 2>&1 || return 1

  local monitors monitor client monitor_id=""
  monitors=$(hyprctl monitors -j 2>/dev/null) || return 1

  if client=$(preview_client); then
    monitor_id=$(jq -r '.monitor // empty' <<<"$client")
  fi

  if [[ -n $monitor_id ]]; then
    monitor=$(jq -cer --argjson id "$monitor_id" 'first(.[] | select(.id == $id)) // empty' <<<"$monitors" 2>/dev/null) || return 1
  else
    monitor=$(jq -cer 'first(.[] | select(.focused == true)) // .[0] // empty' <<<"$monitors" 2>/dev/null) || return 1
  fi

  jq -r '
    . as $m
    | (($m.transform // 0) % 2 == 1) as $rotated
    | [ (((if $rotated then .height else .width end) / .scale) | floor),
        (((if $rotated then .width else .height end) / .scale) | floor) ]
    | @tsv' <<<"$monitor"
}

# Whether the stream at its real size would fit on that monitor. This is the
# dynamic answer to "is original going to be huge here": a fixed threshold would
# be wrong on any display that is not the one it was picked for, and wrong again
# as soon as the window moves to a second monitor.
#
# 0 fits, 1 does not, 2 unknown. Unknown is kept distinct from "does not fit" on
# purpose: not being able to measure is not evidence of a problem, and warning
# on it would mean warning with question marks where the numbers should be.
preview_original_fits() {
  local nw nh mw mh
  read -r nw nh < <(preview_native_size) || return 2
  read -r mw mh < <(preview_target_monitor) || return 2
  ((nw <= mw && nh <= mh)) || return 1
  return 0
}

# -------------------------------------------------------------- anchoring ----

preview_anchor_valid() {
  local candidate="${1:-}" anchor
  for anchor in "${PREVIEW_ANCHORS[@]}"; do
    [[ $anchor == "$candidate" ]] && return 0
  done
  return 1
}

# The anchor the preview belongs at: the last one it was moved or snapped to,
# or the bottom-right corner it has always opened in.
preview_anchor_name() {
  local anchor=""
  [[ -r $PREVIEW_ANCHOR_FILE ]] && read -r anchor <"$PREVIEW_ANCHOR_FILE" 2>/dev/null
  preview_anchor_valid "$anchor" || anchor="$PREVIEW_DEFAULT_ANCHOR"
  printf '%s\n' "$anchor"
}

preview_anchor_save() {
  preview_anchor_valid "${1:-}" || return 1
  # Best effort: not being able to remember the position is not a reason to
  # refuse to move the window there.
  ensure_config_dir || return 0
  printf '%s\n' "$1" >"$PREVIEW_ANCHOR_FILE" 2>/dev/null || true
}

# A monitor's logical geometry and its reserved area, as one line of numbers:
# x y width height reservedLeft reservedTop reservedRight reservedBottom.
# Logical rather than physical, because window geometry is in logical units.
monitor_box() {
  jq -r '
    . as $m
    | (($m.transform // 0) % 2 == 1) as $rotated
    | (.reserved // [0, 0, 0, 0]) as $r
    | [ .x, .y,
        (((if $rotated then .height else .width end) / .scale) | floor),
        (((if $rotated then .width else .height end) / .scale) | floor),
        ($r[0] // 0), ($r[1] // 0), ($r[2] // 0), ($r[3] // 0) ]
    | @tsv'
}

preview_margin() {
  local height="${1:-0}" margin
  margin=$((height * PREVIEW_MARGIN_PER_MILLE / 1000))
  ((margin < PREVIEW_MARGIN_MIN)) && margin=$PREVIEW_MARGIN_MIN
  ((margin > PREVIEW_MARGIN_MAX)) && margin=$PREVIEW_MARGIN_MAX
  printf '%s\n' "$margin"
}

# The rectangle a preview may occupy on a monitor: its logical size, less what
# layer surfaces reserved — the Omarchy bar, mainly — and less the margin.
# Without the reserved area the top anchors would tuck the window under the bar.
usable_box() {
  local mx="$1" my="$2" mw="$3" mh="$4" rl="$5" rt="$6" rr="$7" rb="$8"
  local margin
  margin=$(preview_margin "$mh")
  printf '%s %s %s %s\n' \
    $((mx + rl + margin)) \
    $((my + rt + margin)) \
    $((mw - rl - rr - 2 * margin)) \
    $((mh - rt - rb - 2 * margin))
}

# Where a window of this size sits when parked at an anchor. Pure arithmetic,
# with no compositor behind it, so the same maths can be exercised from a test.
#
# A window bigger than the box it is placed in is pinned to that box's edge on
# the axis it overflows rather than hung off the far side: "original" on a phone
# that out-resolves the monitor is meant to overflow, but it has to overflow
# from a corner that can still be grabbed.
anchor_origin() {
  local anchor="$1" width="$2" height="$3" ux="$4" uy="$5" uw="$6" uh="$7"
  local x y

  case "$anchor" in
  *left) x=$ux ;;
  *right) x=$((ux + uw - width)) ;;
  *) x=$((ux + (uw - width) / 2)) ;;
  esac

  case "$anchor" in
  top*) y=$uy ;;
  bottom*) y=$((uy + uh - height)) ;;
  *) y=$((uy + (uh - height) / 2)) ;;
  esac

  ((width >= uw)) && x=$ux
  ((height >= uh)) && y=$uy

  printf '%s %s\n' "$x" "$y"
}

# How far a dropped window may be from an anchor and still be pulled onto it.
# Proportional to the screen, so the magnet feels the same on a 1080p laptop and
# on a 4K desktop, bounded so it is neither imperceptible nor screen-wide.
preview_snap_threshold() {
  local threshold=$((${1:-0} * 12 / 100))
  ((threshold < 80)) && threshold=80
  ((threshold > 200)) && threshold=200
  printf '%s\n' "$threshold"
}

# The anchor a dropped window is closest to, or failure when it is further from
# every one of them than the threshold. Dropping a window in open space has to
# leave it in open space, or snapping stops being an assist and becomes a cage.
#
# Distance is measured corner to corner. The window keeps its size, so corner to
# corner and centre to centre rank the anchors identically, and the corner is
# the number the placement actually uses.
nearest_anchor() {
  local width="$1" height="$2" x="$3" y="$4"
  local ux="$5" uy="$6" uw="$7" uh="$8" threshold="$9"
  local best="" best_distance=-1
  local anchor ax ay dx dy distance

  # A window too big for the box on both axes has no anchor to be at: every one
  # of them resolves to the same corner. Snapping it would be a magnet with one
  # pole, dragging it back to that corner on every drop.
  ((width >= uw && height >= uh)) && return 1

  # With one axis unusable, every anchor along it resolves to the same place.
  # Scanning only the ones that name the free axis keeps the answer — and so the
  # position that gets remembered — from depending on the order of the list.
  local candidates=("${PREVIEW_ANCHORS[@]}")
  ((width >= uw)) && candidates=(top center bottom)
  ((height >= uh)) && candidates=(left center right)

  for anchor in "${candidates[@]}"; do
    read -r ax ay < <(anchor_origin "$anchor" "$width" "$height" "$ux" "$uy" "$uw" "$uh")
    dx=$((x - ax))
    dy=$((y - ay))
    # An oversized window has nowhere to go on the axis it overflows: every
    # anchor puts it in the same place. Counting that unavoidable offset would
    # let it push every anchor out of range, so the free axis decides alone.
    ((width >= uw)) && dx=0
    ((height >= uh)) && dy=0
    distance=$((dx * dx + dy * dy))
    if ((best_distance < 0 || distance < best_distance)); then
      best_distance=$distance
      best=$anchor
    fi
  done

  ((best_distance >= 0)) || return 1
  ((best_distance <= threshold * threshold)) || return 1
  printf '%s\n' "$best"
}

# Where a snap actually puts the window: at the anchor, except on an axis the
# window is too big for, where it keeps the coordinate it already had. An
# oversized preview is dragged to choose which part of the frame is on screen,
# and a magnet that hauled it back to the same corner would be fighting that.
snap_target() {
  local anchor="$1" width="$2" height="$3" x="$4" y="$5"
  local ux="$6" uy="$7" uw="$8" uh="$9"
  local ax ay
  read -r ax ay < <(anchor_origin "$anchor" "$width" "$height" "$ux" "$uy" "$uw" "$uh")
  ((width >= uw)) && ax=$x
  ((height >= uh)) && ay=$y
  printf '%s %s\n' "$ax" "$ay"
}


# --------------------------------------------------------------- snapping ----

# Whether the magnet is on: the environment first, because that is how the panel
# passes its setting through, then the saved preference, then on. Snapping is a
# default rather than an opt-in — a preview that lands square on an edge is what
# people expect of an overlay, and the setting exists for when it is not wanted.
preview_snap_enabled() {
  local value="$PREVIEW_SNAP"
  if [[ -z $value && -r $PREVIEW_SNAP_FILE ]]; then
    read -r value <"$PREVIEW_SNAP_FILE" 2>/dev/null || value=""
  fi

  case "$value" in
  off | false | 0) return 1 ;;
  *) return 0 ;;
  esac
}

# on or off as a word, for the places that report state rather than branch on it.
preview_snap_word() {
  if preview_snap_enabled; then
    printf 'on\n'
  else
    printf 'off\n'
  fi
}

# Whether the drag now under way is one that should snap. The two ways of moving
# the preview are told apart at the source rather than guessed at: mpv marks the
# moment its own window is grabbed, and a Super drag is taken by the compositor
# before mpv is told anything at all, so it leaves no mark.
#
# Hyprland cannot answer this. It reports no drag events, nothing about which
# mechanism moved a window, and its Lua `is_key_down` does not carry modifiers —
# all three were tried before settling on asking the client that knows.
#
# The scrcpy preview has no mark and no plain drag either, since clicks on it go
# to the phone: Super is the only way to move that window, so every drag counts.
drag_should_snap() {
  [[ $PREVIEW_SOURCE == scrcpy ]] && return 0

  local marked
  marked=$(stat -c %Y "$PREVIEW_DRAG_FILE" 2>/dev/null) || return 1
  [[ $marked =~ ^[0-9]+$ ]] || return 1
  ((EPOCHSECONDS - marked <= PREVIEW_DRAG_GRACE))
}

# Hyprland has a magnet of its own for floating windows, and it runs inside the
# drag: the window clings to an edge while it is still under the cursor. Nothing
# watching from outside can imitate that — the compositor owns a window's
# position for as long as a drag lasts — so omavcam turns Hyprland's on while
# the preview is open and puts it back afterwards.
#
# What it cannot do is leave a gap: its monitor_gap is the distance at which the
# magnet grabs, not the distance it leaves, so it parks flush against the edge.
# The gap is omavcam's half of the job, applied when the drag ends, and eased by
# the compositor's own move animation.
#
# It is a compositor-wide setting — every floating window snaps while the
# preview is open — which is exactly why the previous values are saved rather
# than assumed.
hypr_set_snap() {
  local enabled="$1" gap="$2" output

  output=$(hyprctl repl "hl.config({ general = { snap = { enabled = $enabled, monitor_gap = $gap } } })" 2>&1) || output="error"
  [[ $output != *error* ]] && return 0

  # Older Hyprland, parsing its config the legacy way.
  hyprctl keyword general:snap:enabled "$enabled" >/dev/null 2>&1 || true
  hyprctl keyword general:snap:monitor_gap "$gap" >/dev/null 2>&1 || true
}

hypr_snap_apply() {
  local gap="$1"
  command -v hyprctl >/dev/null 2>&1 || return 0
  have jq || return 0

  # Read as text and checked, not with `jq -e`: a bool that is genuinely false
  # exits non-zero there, which reads as "Hyprland does not have this option"
  # and would switch the magnet off for everyone who had not already turned it
  # on themselves — which is everyone.
  local enabled_now gap_now
  enabled_now=$(hyprctl getoption -j general:snap:enabled 2>/dev/null | jq -r '.bool | tostring' 2>/dev/null)
  gap_now=$(hyprctl getoption -j general:snap:monitor_gap 2>/dev/null | jq -r '.int | tostring' 2>/dev/null)
  [[ $enabled_now == true || $enabled_now == false ]] || return 0
  [[ $gap_now =~ ^[0-9]+$ ]] || return 0

  # Written once. Opening the preview twice must not record omavcam's own
  # values as the ones to go back to.
  if [[ ! -e $PREVIEW_HYPR_SNAP_FILE ]]; then
    ensure_state_dir
    jq -n --argjson enabled "$enabled_now" --argjson gap "$gap_now" \
      '{enabled: $enabled, monitorGap: $gap}' >"$PREVIEW_HYPR_SNAP_FILE"
  fi

  hypr_set_snap true "$gap"
}

hypr_snap_restore() {
  [[ -r $PREVIEW_HYPR_SNAP_FILE ]] || return 0
  command -v hyprctl >/dev/null 2>&1 || return 0

  local enabled gap
  enabled=$(jq -r '.enabled' <"$PREVIEW_HYPR_SNAP_FILE" 2>/dev/null) || enabled=""
  gap=$(jq -r '.monitorGap' <"$PREVIEW_HYPR_SNAP_FILE" 2>/dev/null) || gap=""
  rm -f "$PREVIEW_HYPR_SNAP_FILE"

  [[ $enabled == true || $enabled == false ]] || return 0
  [[ $gap =~ ^[0-9]+$ ]] || gap=10
  hypr_set_snap "$enabled" "$gap"
}

# The magnet's reach, on the monitor the preview is on: the same gap it will be
# parked at, so it grabs about when the window reaches the place it is going.
hypr_snap_gap() {
  local mw mh
  read -r mw mh < <(preview_target_monitor) || return 1
  preview_margin "$mh"
}

# mpv is given its own bindings, written fresh each time the preview opens.
#
# Binding the button explicitly is also what makes a plain drag work at all:
# left to itself, mpv decides whether a click was meant to move the window, and
# that decision is not one the preview should depend on.
preview_write_input_conf() {
  local marker
  marker=$(command -v touch) || marker=""

  {
    printf '# Written by omavcam every time the preview opens. Edits are lost.\n'
    if [[ -n $marker ]]; then
      printf 'MBTN_LEFT run "%s" "%s"; begin-vo-dragging\n' "$marker" "$PREVIEW_DRAG_FILE"
    else
      printf 'MBTN_LEFT begin-vo-dragging\n'
    fi
    # Without this a slightly enthusiastic drag puts the preview fullscreen.
    printf 'MBTN_LEFT_DBL ignore\n'
  } >"$PREVIEW_INPUT_CONF"
}

preview_snap_save() {
  ensure_config_dir || return 0
  printf '%s\n' "$1" >"$PREVIEW_SNAP_FILE" 2>/dev/null || true
}

# The window's position, size, monitor and address, straight from the
# compositor. One hyprctl and one jq rather than reusing preview_client and
# picking the fields out afterwards: this runs on every tick of the watcher, and
# a third process per tick is a third of the cost of watching at all.
preview_geometry() {
  command -v hyprctl >/dev/null 2>&1 || return 1
  hyprctl clients -j 2>/dev/null |
    jq -er --arg t "$PREVIEW_TITLE" \
      'first(.[] | select(.title == $t)) // empty
       | [.at[0], .at[1], .size[0], .size[1], .monitor, .address] | @tsv' 2>/dev/null
}

# Pull the preview onto the anchor it was dropped nearest, if it was dropped
# near one at all. Prints the anchor and the coordinates it ended up at, so the
# watcher knows what it is now looking at; fails without touching the window
# when the drop belongs where it landed.
preview_snap_now() {
  local x y width height monitor_id address
  read -r x y width height monitor_id address < <(preview_geometry) || return 1
  [[ -n ${address:-} ]] || return 1

  local monitor
  monitor=$(hyprctl monitors -j 2>/dev/null |
    jq -cer --argjson id "$monitor_id" 'first(.[] | select(.id == $id)) // empty' 2>/dev/null) || return 1

  local mx my mw mh rl rt rr rb
  read -r mx my mw mh rl rt rr rb < <(monitor_box <<<"$monitor")

  local ux uy uw uh
  read -r ux uy uw uh < <(usable_box "$mx" "$my" "$mw" "$mh" "$rl" "$rt" "$rr" "$rb")

  local anchor
  anchor=$(nearest_anchor "$width" "$height" "$x" "$y" \
    "$ux" "$uy" "$uw" "$uh" "$(preview_snap_threshold "$mh")") || return 1

  local tx ty
  read -r tx ty < <(snap_target "$anchor" "$width" "$height" "$x" "$y" "$ux" "$uy" "$uw" "$uh")

  # Worth saving even when the window is already there: this is how dragging the
  # preview teaches a later resize or reopen where it belongs.
  preview_anchor_save "$anchor"

  if ((tx != x || ty != y)); then
    local window="address:$address"
    hypr_dispatch \
      "hl.dsp.window.move({ window = \"$window\", x = $tx, y = $ty })" \
      movewindowpixel "exact $tx $ty,$window"
  fi

  printf '%s %s %s\n' "$anchor" "$tx" "$ty"
}

# Watches the preview for the end of a drag. It owns no window and kills no
# process: the worst a stuck watcher can do is move the preview, and it exits
# on its own as soon as the window it is watching is gone.
preview_watch_loop() {
  # The watcher records its own pid rather than being handed one: setsid forks,
  # so the caller's $! is the pid of setsid and not of the process that outlives
  # it. Recording it from the inside is the only version that is always right.
  ensure_state_dir
  printf '%s\n' "$$" >"$PREVIEW_WATCH_PID_FILE"
  trap 'rm -f "$PREVIEW_WATCH_PID_FILE"; exit 0' TERM INT

  local x y width height monitor_id address
  local previous="" settled="" resolved=""
  local still=0 interval="$PREVIEW_WATCH_IDLE" snapping_drag=unknown
  local missed=0

  while preview_snap_enabled; do
    # A reading can fail without the window being gone — the compositor is busy,
    # the socket is slow, the window is mid-remap on a source switch. Exiting on
    # the first miss meant the watcher could quietly disappear and leave the
    # preview un-snapping with nothing to show why, so it takes three in a row
    # to count as "the window is gone".
    if ! read -r x y width height monitor_id address < <(preview_geometry); then
      missed=$((missed + 1))
      ((missed >= 3)) && break
      sleep "$PREVIEW_WATCH_IDLE"
      continue
    fi
    missed=0

    # Size and monitor belong in the sample: a resize or a move to another
    # screen changes where the anchors are, so both have to reopen the question
    # of where the window should be.
    local current="$x $y $width $height $monitor_id"

    if [[ $current == "$previous" ]]; then
      still=$((still + 1))
    else
      still=0
      interval="$PREVIEW_WATCH_ACTIVE"

      # Settled at the first sign of movement, while the mark left by the click
      # that began the drag is still fresh, and consumed there: one click can
      # only answer for one drag.
      if [[ $snapping_drag == unknown && -n $previous ]]; then
        if drag_should_snap; then snapping_drag=yes; else snapping_drag=no; fi
        rm -f "$PREVIEW_DRAG_FILE"
      fi
    fi
    previous="$current"

    # Exactly at the settle count, so this fires once per drag rather than on
    # every tick the window then spends sitting still.
    if ((still == PREVIEW_WATCH_SETTLE)) && [[ $current != "$settled" ]]; then
      settled="$current"

      # A Super drag ends here: the position is the whole point of the gesture,
      # and the remembered anchor is left alone rather than overwritten by a
      # place that is deliberately not one.
      if [[ $snapping_drag == yes ]] && resolved=$(preview_snap_now); then
        # The window is about to move, which reads as motion on the next tick.
        # Recording where it was sent stops that from looking like a new drag.
        read -r _ x y <<<"$resolved"
        previous="$x $y $width $height $monitor_id"
        settled="$previous"
      fi
      snapping_drag=unknown
    fi

    ((still > PREVIEW_WATCH_SETTLE)) && interval="$PREVIEW_WATCH_IDLE"
    sleep "$interval"
  done

  rm -f "$PREVIEW_WATCH_PID_FILE"
}

# Same shape as the preview's own pid check: a pid file is not proof, so the
# process behind it has to still be ours before anything is done with it.
preview_watch_pid() {
  local pid
  [[ -r $PREVIEW_WATCH_PID_FILE ]] || return 1
  read -r pid <"$PREVIEW_WATCH_PID_FILE" || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ -r /proc/$pid/cmdline ]] || return 1
  tr '\0' ' ' </proc/"$pid"/cmdline | grep -q -- 'preview watch' || return 1
  printf '%s\n' "$pid"
}

preview_watch_running() {
  preview_watch_pid >/dev/null 2>&1
}

preview_watch_start() {
  preview_snap_enabled || return 0
  preview_running || return 0
  preview_watch_running && return 0
  command -v hyprctl >/dev/null 2>&1 || return 0

  # BASH_SOURCE rather than $0: it names this file whatever the script was
  # invoked as, and a plugin directory is not on PATH, so the watcher can only
  # be re-entered by absolute path.
  local self
  self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null) || self="${BASH_SOURCE[0]}"
  [[ -x $self ]] || return 0

  ensure_state_dir
  setsid "$self" preview watch >/dev/null 2>&1 &

  # The watcher writes its own pid file; wait for it, so that a start followed
  # immediately by a status does not report a watcher that is on its way up.
  local waited=0
  while ((waited < 20)) && ! preview_watch_running; do
    sleep 0.05
    waited=$((waited + 1))
  done
}

preview_watch_stop() {
  local pid
  if pid=$(preview_watch_pid); then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$PREVIEW_WATCH_PID_FILE"
}

# Presets scale from monitor height, so the preview occupies the same share of
# a 1080p screen and a 4K one. Placed at the remembered anchor, which starts out
# as the bottom-right corner, matching where Omarchy's own webcam overlay sits.
preview_place() {
  local size_name="$1"
  local anchor="${2:-}"
  [[ -n $anchor ]] || anchor=$(preview_anchor_name)
  command -v hyprctl >/dev/null 2>&1 || return 0

  local client address
  client=$(preview_client) || return 0
  address=$(jq -r '.address' <<<"$client")
  [[ -n $address ]] || return 0

  local monitor_id
  monitor_id=$(jq -r '.monitor' <<<"$client")
  local monitor
  monitor=$(hyprctl monitors -j 2>/dev/null |
    jq -cer --argjson id "$monitor_id" 'first(.[] | select(.id == $id)) // empty' 2>/dev/null) || return 0

  local mx my mw mh rl rt rr rb
  read -r mx my mw mh rl rt rr rb < <(monitor_box <<<"$monitor")

  local ux uy uw uh
  read -r ux uy uw uh < <(usable_box "$mx" "$my" "$mw" "$mh" "$rl" "$rt" "$rr" "$rb")

  local width height
  local native_w native_h

  if [[ $size_name == original ]] && read -r native_w native_h < <(preview_native_size); then
    # Deliberately unclamped: "original" means the stream's real pixels, one for
    # one, even when the phone out-resolves the monitor — a 4080x3060 camera on
    # a 2048x1152 desktop is supposed to overflow. The placement below pins it
    # to the top-left corner so it can be dragged from there.
    width=$native_w
    height=$native_h
  else
    local fraction
    case "$size_name" in
    small) fraction=18 ;;
    large | original) fraction=34 ;;
    *) fraction=25 ;;
    esac

    local aw ah
    read -r aw ah < <(preview_aspect)

    height=$((mh * fraction / 100))
    width=$((height * aw / ah))

    # A wide stream on a short screen can overflow; clamp to the space the
    # margins and the bar leave rather than letting the preview run off the
    # monitor. Only the proportional presets are clamped — original is meant to
    # overflow.
    if ((uw > 0 && width > uw)); then
      width=$uw
      height=$((width * ah / aw))
    fi
  fi

  local x y
  read -r x y < <(anchor_origin "$anchor" "$width" "$height" "$ux" "$uy" "$uw" "$uh")

  local window="address:$address"
  hypr_dispatch \
    "hl.dsp.window.resize({ window = \"$window\", x = $width, y = $height })" \
    resizewindowpixel "exact $width $height,$window"
  hypr_dispatch \
    "hl.dsp.window.move({ window = \"$window\", x = $x, y = $y })" \
    movewindowpixel "exact $x $y,$window"
}

# Re-runs the current capture with or without scrcpy's window, reusing the
# settings it was started with so toggling the preview never silently changes
# the camera or resolution.
restart_capture_with_window() {
  local want_window="$1"
  local meta='{}'
  [[ -r $META_FILE ]] && meta=$(cat "$META_FILE")

  local args=()
  local value
  value=$(jq -r '.serial // ""' <<<"$meta")
  [[ -n $value ]] && args+=(-s "$value")
  value=$(jq -r '.cameraId // ""' <<<"$meta")
  if [[ -n $value ]]; then
    args+=(--camera-id "$value")
  else
    value=$(jq -r '.facing // ""' <<<"$meta")
    [[ -n $value ]] && args+=(--facing "$value")
  fi
  value=$(jq -r '.size // ""' <<<"$meta")
  [[ -n $value ]] && args+=(--size "$value")
  value=$(jq -r '.fps // ""' <<<"$meta")
  [[ -n $value ]] && args+=(--fps "$value")
  [[ $want_window == true ]] && args+=(--window)

  cmd_stop >/dev/null
  cmd_start ${args[@]+"${args[@]}"}
}

# Opening the preview always starts it small. A window that reappears at
# whatever size it was left at weeks ago is a surprise, and "large" or
# "original" covering the screen on open is a bad one — small is the size that
# is never in the way, and resizing from there is one keystroke.
#
# --keep-size is for reopens that are not the user asking for a preview: a
# source switch, or the reopen after a setting is applied to a live stream.
# Resetting those would shrink the window out from under someone who had just
# sized it.
preview_start() {
  local keep_size=false
  [[ ${1:-} == --keep-size ]] && keep_size=true

  if preview_running; then
    printf 'Preview is already open.\n'
    return 0
  fi

  ensure_state_dir
  if [[ $keep_size == false ]]; then
    printf 'small\n' >"$PREVIEW_SIZE_FILE"
  fi

  local size_name
  size_name=$(preview_size_name)

  if [[ $PREVIEW_SOURCE == scrcpy ]]; then
    capture_running || die "start a capture before opening the preview"
    apply_preview_rules
    restart_capture_with_window true
    wait_for_preview
    preview_place "$size_name"
    preview_watch_start
    preview_snap_enabled && hypr_snap_apply "$(hypr_snap_gap)"
    return 0
  fi

  device_streaming || die "nothing is streaming yet — run 'omavcam start' first"
  have mpv || die "mpv is not installed"

  ensure_state_dir
  apply_preview_rules
  rm -f "$PREVIEW_DRAG_FILE"
  preview_write_input_conf

  # Reading the node rather than the phone means the preview shows exactly the
  # frames the meeting app receives — same crop, same orientation, same lag.
  setsid mpv "av://v4l2:$DEVICE" \
    --profile=low-latency --untimed --no-cache \
    --title="$PREVIEW_TITLE" --wayland-app-id="$(preview_app_id "$size_name")" \
    --no-border --no-audio --no-osc --osd-level=0 --really-quiet \
    --window-dragging=yes --input-conf="$PREVIEW_INPUT_CONF" \
    >/dev/null 2>&1 &
  printf '%s\n' "$!" >"$PREVIEW_PID_FILE"

  wait_for_preview
  preview_place "$size_name"
  preview_watch_start
  preview_snap_enabled && hypr_snap_apply "$(hypr_snap_gap)"
  printf 'Preview open.\n'
}

# The window has to be mapped before it can be positioned, or it is placed and
# then re-placed by the compositor as it appears.
wait_for_preview() {
  local waited=0
  while ((waited < 60)) && ! preview_client >/dev/null 2>&1; do
    sleep 0.1
    waited=$((waited + 1))
  done
}

preview_stop() {
  preview_watch_stop
  hypr_snap_restore
  rm -f "$PREVIEW_DRAG_FILE"

  local source
  source=$(preview_running_source 2>/dev/null) || source="$PREVIEW_SOURCE"

  if [[ $source == scrcpy ]]; then
    capture_running && restart_capture_with_window false
    rm -f "$PREVIEW_PID_FILE"
    return 0
  fi

  local pid=""
  pid=$(preview_pid || preview_client_pid || preview_scan_pid || true)

  if [[ -n $pid ]]; then
    kill "$pid" 2>/dev/null || true
    local waited=0
    while ((waited < 20)) && kill -0 "$pid" 2>/dev/null; do
      sleep 0.1
      waited=$((waited + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi

  # The window is borderless and takes no focus, so a survivor cannot be closed
  # by hand. Ask the compositor directly before giving up.
  local client address
  if client=$(preview_client); then
    address=$(jq -r '.address // empty' <<<"$client")
    if [[ -n $address ]]; then
      hyprctl dispatch closewindow "address:$address" >/dev/null 2>&1 || true
    fi
    sleep 0.3
  fi

  rm -f "$PREVIEW_PID_FILE"

  # Only claim success once the window is actually gone, so "Preview closed."
  # can never be printed over a preview that is still on screen.
  if preview_running; then
    printf 'Could not close the preview window.\n' >&2
    return 1
  fi
  printf 'Preview closed.\n'
}

cmd_preview() {
  local action="${1:-toggle}"
  shift || true

  have jq || die "jq is required"
  ensure_state_dir

  case "$action" in
  on) preview_start ;;
  off) preview_stop ;;
  toggle)
    if preview_running; then preview_stop; else preview_start; fi
    ;;
  reopen)
    # Switching source cannot be done in place: the two sources are different
    # windows owned by different processes. The size is the user's current
    # choice, though, so it carries across.
    if preview_running; then preview_stop >/dev/null; fi
    preview_start --keep-size
    ;;
  status)
    if preview_running; then
      printf 'open\n'
    else
      printf 'closed\n'
      return 1
    fi
    ;;
  snap)
    local state="${1:-toggle}"
    case "$state" in
    on) ;;
    off) ;;
    toggle)
      if preview_snap_enabled; then state=off; else state=on; fi
      ;;
    status)
      preview_snap_enabled || {
        printf 'off\n'
        return 1
      }
      printf 'on\n'
      return 0
      ;;
    *) die "preview snap takes on, off, toggle, or status" ;;
    esac

    preview_snap_save "$state"
    # The environment beats the file, so a panel that passes the opposite value
    # would leave the CLI reporting one thing and doing another. Say so rather
    # than pretending the preference took.
    if [[ -n $PREVIEW_SNAP && $PREVIEW_SNAP != "$state" ]]; then
      printf 'Saved, but OMAVCAM_PREVIEW_SNAP=%s is set and wins for this run.\n' \
        "$PREVIEW_SNAP" >&2
    fi

    if [[ $state == on ]]; then
      preview_watch_start
      preview_running && hypr_snap_apply "$(hypr_snap_gap)"
    else
      preview_watch_stop
      hypr_snap_restore
    fi
    printf '%s\n' "$state"
    ;;
  watch)
    # Internal: the drag watcher, started and stopped with the preview. Running
    # it by hand is harmless — a second one exits immediately.
    preview_watch_running && return 0
    preview_watch_loop
    ;;
  move)
    local anchor="${1:-}"
    preview_anchor_valid "$anchor" ||
      die "preview move takes one of: ${PREVIEW_ANCHORS[*]}"
    preview_running || die "the preview is not open"
    preview_anchor_save "$anchor"
    preview_place "$(preview_size_name)" "$anchor"
    printf '%s\n' "$anchor"
    ;;
  resize)
    local preset="${1:-reset}"
    local current
    current=$(preview_size_name)
    case "$preset" in
    small | medium | large | original) ;;
    reset) preset=medium ;;
    larger)
      case "$current" in
      small) preset=medium ;;
      medium) preset=large ;;
      large) preset=original ;;
      *) preset=original ;;
      esac
      ;;
    smaller)
      case "$current" in
      original) preset=large ;;
      large) preset=medium ;;
      medium) preset=small ;;
      *) preset=small ;;
      esac
      ;;
    *) die "preview resize takes small, medium, large, original, smaller, larger, or reset" ;;
    esac
    if [[ $preset == original ]]; then
      local fits=0
      preview_original_fits || fits=$?
      # Only when it is known not to fit — never on the unknown case, which
      # would print a warning full of question marks.
      if ((fits == 1)); then
        local nw nh mw mh
        read -r nw nh < <(preview_native_size)
        read -r mw mh < <(preview_target_monitor)
        printf 'Original is %sx%s, larger than this screen (%sx%s) — the window will extend past the edges.\n' \
          "$nw" "$nh" "$mw" "$mh" >&2
      fi
    fi

    printf '%s\n' "$preset" >"$PREVIEW_SIZE_FILE"
    # mpv's app id is fixed at launch and carries the preset name, so a resize
    # only needs to move the existing window, not relaunch it.
    preview_place "$preset"
    printf '%s\n' "$preset"
    ;;
  *) die "unknown preview action: $action" ;;
  esac
}

# --------------------------------------------------------------- restart ----

# scrcpy fixes the camera, resolution and frame rate when it launches — none of
# them can be changed on a live stream. Applying a new setting therefore means
# restarting the capture, and restart exists so that callers do not have to
# reconstruct the settings the stream was already using.
#
# Flags left out are inherited from the running capture; a flag given with an
# empty value clears it. That distinction is why this cannot simply be
# "stop; start": a panel that omits --size means "leave it alone", while one
# that sends --size "" means "back to the camera default".
cmd_restart() {
  local set_serial=false set_facing=false set_camera=false set_size=false set_fps=false
  local serial="" facing="" camera_id="" size="" fps=""
  local want_window=""

  while (($# > 0)); do
    case "$1" in
    -s | --serial)
      (($# >= 2)) || die "--serial needs a value"
      serial="$2" set_serial=true
      shift
      ;;
    --facing)
      (($# >= 2)) || die "--facing needs a value"
      facing="$2" set_facing=true
      shift
      ;;
    --camera-id)
      (($# >= 2)) || die "--camera-id needs a value"
      camera_id="$2" set_camera=true
      shift
      ;;
    --size)
      (($# >= 2)) || die "--size needs a value"
      size="$2" set_size=true
      shift
      ;;
    --fps)
      (($# >= 2)) || die "--fps needs a value"
      fps="$2" set_fps=true
      shift
      ;;
    --window) want_window=true ;;
    --no-window) want_window=false ;;
    *) die "unknown option for restart: $1" ;;
    esac
    shift
  done

  have jq || die "jq is required"

  local meta='{}'
  [[ -r $META_FILE ]] && meta=$(cat "$META_FILE")

  [[ $set_serial == true ]] || serial=$(jq -r '.serial // ""' <<<"$meta")
  [[ $set_size == true ]] || size=$(jq -r '.size // ""' <<<"$meta")
  [[ $set_fps == true ]] || fps=$(jq -r '.fps // ""' <<<"$meta")
  [[ -n $want_window ]] || want_window=$(jq -r 'if .window == true then "true" else "false" end' <<<"$meta")

  # Facing and camera id are mutually exclusive in scrcpy, so setting either one
  # explicitly retires the other rather than leaving a stale value to win.
  if [[ $set_camera == true ]]; then
    facing=""
  elif [[ $set_facing == true ]]; then
    camera_id=""
  else
    camera_id=$(jq -r '.cameraId // ""' <<<"$meta")
    facing=$(jq -r '.facing // ""' <<<"$meta")
  fi

  # A loopback preview reads the node the capture feeds, so it dies the moment
  # the stream stops. Reopen it afterwards, or applying a setting would silently
  # close the window the user was watching.
  local preview_was_open=false
  if [[ -n $(loopback_preview_pid || true) ]]; then
    preview_was_open=true
  fi

  loopback_preview_stop
  capture_running && cmd_stop >/dev/null

  local args=()
  [[ -n $serial ]] && args+=(-s "$serial")
  if [[ -n $camera_id ]]; then
    args+=(--camera-id "$camera_id")
  elif [[ -n $facing ]]; then
    args+=(--facing "$facing")
  fi
  [[ -n $size ]] && args+=(--size "$size")
  [[ -n $fps ]] && args+=(--fps "$fps")
  [[ $want_window == true ]] && args+=(--window)

  local started=true
  cmd_start ${args[@]+"${args[@]}"} || started=false

  # A resolution belongs to one camera: switch cameras and the old size may not
  # exist on the new one, which scrcpy rejects outright. Refusing to come back
  # at all would be the worst outcome — the user changed a setting and lost
  # their camera mid-call — so fall back to the camera's own default and say so.
  if [[ $started == false && -n $size ]]; then
    printf 'That resolution is not available on this camera; using its default.\n' >&2
    local retry=()
    local arg skip=false
    for arg in ${args[@]+"${args[@]}"}; do
      if [[ $skip == true ]]; then
        skip=false
        continue
      fi
      if [[ $arg == --size ]]; then
        skip=true
        continue
      fi
      retry+=("$arg")
    done
    if cmd_start ${retry[@]+"${retry[@]}"}; then
      started=true
    else
      started=false
    fi
  fi

  if [[ $preview_was_open == true ]]; then
    # Reopening after a setting change, not a fresh open — keep the size.
    preview_start --keep-size >/dev/null 2>&1 || true
  fi

  # Report the capture's fate, not the preview's — a masked failure here told
  # the panel everything was fine while the stream was down.
  [[ $started == true ]]
}

# ------------------------------------------------------------- uninstall ----

# setup writes into /etc, so removing the plugin is not enough to undo it.
# Anything this tool put on the system, this tool takes back off — leaving a
# module config behind after a user has removed the plugin would be rude, and
# the marketplace requires removal to be documented.
cmd_uninstall() {
  local assume_yes=false keep_packages=true
  while (($# > 0)); do
    case "$1" in
    --yes | -y) assume_yes=true ;;
    --packages) keep_packages=false ;;
    *) die "unknown option for uninstall: $1" ;;
    esac
    shift
  done

  printf 'This removes omavcam'"'"'s system configuration:\n'
  printf '  %s\n' "$MODPROBE_CONF"
  printf '  %s\n' "$MODULES_LOAD_CONF"
  printf 'and unloads the %s module if nothing else is using it.\n' "$MODULE"
  [[ $keep_packages == false ]] && printf 'It also removes: %s\n' "${REQUIRED_PACKAGES[*]}"
  printf '\n'

  if [[ $assume_yes == false ]]; then
    read -r -p 'Continue? [y/N] ' reply
    [[ $reply =~ ^[Yy] ]] || die "cancelled"
  fi

  capture_running && cmd_stop >/dev/null
  loopback_preview_stop

  local path
  for path in "$MODPROBE_CONF" "$MODULES_LOAD_CONF"; do
    if [[ -e $path ]]; then
      printf 'Removing %s\n' "$path"
      sudo rm -f "$path"
    fi
  done

  # Only unload what we can see is idle: another application may have opened a
  # different loopback node on the same module, and taking it out from under
  # them would break their camera to tidy up ours.
  if module_loaded; then
    if sudo modprobe -r "$MODULE" 2>/dev/null; then
      printf 'Unloaded %s\n' "$MODULE"
    else
      printf '%s is still in use; it will be gone after a reboot.\n' "$MODULE" >&2
    fi
  fi

  if [[ $keep_packages == false ]]; then
    printf 'Removing packages: %s\n' "${REQUIRED_PACKAGES[*]}"
    sudo pacman -Rs --noconfirm "${REQUIRED_PACKAGES[@]}" || true
  fi

  rm -rf "$STATE_DIR" "$CONFIG_DIR"
  printf '\nDone. Remove the plugin itself with:\n'
  printf '  omarchy plugin remove sphiment.omavcam\n'
}

# The anchor a drop snaps to and the coordinates it lands on, with the
# compositor taken out of the loop: everything hyprctl would have reported is
# passed in instead. Prints "anchor x y", or "none" when the drop is out of
# range of every anchor. Not in the usage text — it exists so the geometry can
# be tested on a machine with no Hyprland, no phone and no monitors, which is
# where CI runs.
cmd_snap_nearest() {
  (($# == 12)) ||
    die "__snap-nearest takes mx my mw mh resLeft resTop resRight resBottom width height x y"

  local value
  for value in "$@"; do
    [[ $value =~ ^-?[0-9]+$ ]] || die "__snap-nearest takes integers, got: $value"
  done

  local mx="$1" my="$2" mw="$3" mh="$4" rl="$5" rt="$6" rr="$7" rb="$8"
  local width="$9" height="${10}" x="${11}" y="${12}"

  local ux uy uw uh
  read -r ux uy uw uh < <(usable_box "$mx" "$my" "$mw" "$mh" "$rl" "$rt" "$rr" "$rb")

  local anchor
  if ! anchor=$(nearest_anchor "$width" "$height" "$x" "$y" \
    "$ux" "$uy" "$uw" "$uh" "$(preview_snap_threshold "$mh")"); then
    printf 'none\n'
    return 0
  fi

  printf '%s %s\n' "$anchor" \
    "$(snap_target "$anchor" "$width" "$height" "$x" "$y" "$ux" "$uy" "$uw" "$uh")"
}

# The gap for a monitor of that logical height. Hidden, and used by the tests so
# that they describe the rule rather than restate its arithmetic.
cmd_snap_margin() {
  (($# == 1)) || die "__snap-margin takes a monitor height"
  [[ $1 =~ ^[0-9]+$ ]] || die "__snap-margin takes an integer, got: $1"
  preview_margin "$1"
}

# Where a window of that size lands at that anchor, on those numbers. Hidden for
# the same reason as __snap-nearest, and paired with it: one test can then move
# a window to an anchor and check it is snapped back to the same one.
cmd_snap_origin() {
  (($# == 11)) ||
    die "__snap-origin takes anchor mx my mw mh resLeft resTop resRight resBottom width height"

  local anchor="$1"
  shift
  preview_anchor_valid "$anchor" || die "unknown anchor: $anchor"

  local value
  for value in "$@"; do
    [[ $value =~ ^-?[0-9]+$ ]] || die "__snap-origin takes integers, got: $value"
  done

  local ux uy uw uh
  read -r ux uy uw uh < <(usable_box "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8")
  anchor_origin "$anchor" "$9" "${10}" "$ux" "$uy" "$uw" "$uh"
}

# ------------------------------------------------------------------ main ----

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
  doctor) cmd_doctor "$@" ;;
  setup) cmd_setup "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  devices) cmd_devices "$@" ;;
  cameras) cmd_cameras "$@" ;;
  start) cmd_start "$@" ;;
  restart) cmd_restart "$@" ;;
  stop) cmd_stop "$@" ;;
  status) cmd_status "$@" ;;
  preview) cmd_preview "$@" ;;
  __snap-nearest) cmd_snap_nearest "$@" ;;
  __snap-margin) cmd_snap_margin "$@" ;;
  __snap-origin) cmd_snap_origin "$@" ;;
  help | --help | -h) usage ;;
  *)
    usage >&2
    die "unknown command: $command"
    ;;
  esac
}

main "$@"
